# Database (local SQLite for dev, Turso URL for prod)
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=  # Only needed for Turso

# Block explorer key for "audit by address" — one Etherscan V2 key covers all
# supported chains. Get a free key at https://etherscan.io/apis
# ETHERSCAN_API_KEY=

# Model (default: local Ollama)
SPECTR_MODEL=ollama:qwen2.5-coder:1.5b
# ANTHROPIC_API_KEY=sk-ant-...  # Only needed for Claude models
# SPECTR_MODEL=claude-sonnet-4-6

# LemonSqueezy webhook verification
# LEMONSQUEEZY_WEBHOOK_SECRET=
